{
  "name": "yandex-music-downloader",
  "version": "1.0.0",
  "description": "Premium Yandex Music Downloader",
  "author": "maksimhalutin-glitch",
  "repository": "https://github.com/maksimhalutin-glitch/-",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:win":   "electron-builder --win --publish never",
    "build:mac":   "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "node-id3": "^0.2.6",
    "sanitize-filename": "^1.6.3"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ymd.downloader",
    "productName": "Yandex Music Downloader",
    "publish": "never",
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "YandexMusicDownloader-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "artifactName": "YandexMusicDownloader.${ext}"
    },
    "files": ["src/**/*", "package.json"]
  }
}
